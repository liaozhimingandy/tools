# =============================================================================
# tools 后端部署环境变量模板
# 用法：cp .env.example .env，把 <...> 占位替换为真实值。.env 已被 .gitignore 排除。
# 注意：数据库密码含 '@'，这里单独用 TOOLS_PG_PASSWORD 传，容器会自动做 URL 编码，
#       切勿把裸密码拼进 TOOLS_DATABASE_URL（会被误当作 host 分隔符）。
# =============================================================================

# ---- 存储：PostgreSQL（外部托管，端口 6432 为 PgBouncer 连接池）----
# 下面 host / 口令为占位，真实值只写入本文件（已被 gitignore），切勿提交到仓库。
TOOLS_STORE=postgres
TOOLS_PG_HOST=<填数据库IP或域名>
TOOLS_PG_PORT=6432
TOOLS_PG_NAME=tools
TOOLS_PG_USER=tools
TOOLS_PG_PASSWORD=<填真实口令>
# 云库若要求 SSL，设为 require；否则留空
TOOLS_PG_SSLMODE=
# PgBouncer 事务池：默认关闭自动 prepared statement（勿随意开，见 config.py 说明）
TOOLS_PG_PREPARE_THRESHOLD=off
TOOLS_PG_POOL_MAX=8
TOOLS_PG_CONNECT_TIMEOUT=10
# 如需直接给完整 DSN（高级），留空则自动由上面分散变量组装
TOOLS_DATABASE_URL=

# ---- 鉴权：暂时不鉴权（passthrough），前端 Logto 登录后用 sub 填 X-User-Sub ----
# 风险：任何人可伪造 X-User-Sub 读写他人密文；正式多用户上线前切 TOOLS_AUTH_MODE=logto。
TOOLS_AUTH_MODE=passthrough
TOOLS_DEV_AUTH_HEADER=X-User-Sub
TOOLS_PASSTHROUGH_DEFAULT_SUB=anonymous
# 切 logto 时填写以下三件套（任一为空即 fail-closed 拒绝所有请求）：
LOGTO_ISSUER=
LOGTO_AUDIENCE=
LOGTO_JWKS_URL=

# ---- 跨域：前端在 GitHub Pages，须把 Pages 源加入白名单（逗号分隔，可多个）----
# 例：https://<你的账号>.github.io 或自定义域 https://tools.example.com
TOOLS_CORS_ORIGINS=https://<你的账号>.github.io

# ---- 前端公网基路径（仅当用本后端在本机/容器里托管 dist 时才需要）----
# 必须与前端 Vite 的 base / VITE_PUBLIC_PATH 一致，默认 /tools/。
# GitHub Pages 部署由 Pages 直接托管静态资源，此值不影响 Pages，仅影响本地
# 「npm run build + python -m app.main」或容器托管 dist 时的 /tools/assets 挂载。
TOOLS_PUBLIC_PATH=/tools/

# ---- 监听与配额 ----
TOOLS_HOST=0.0.0.0
TOOLS_PORT=8080
TOOLS_MAX_VALUE_BYTES=524288
TOOLS_MAX_KEYS=200
